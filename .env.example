# LLM
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview

# HuggingFace (for Pinecone embeddings)
HUGGINGFACEHUB_API_TOKEN=your-huggingface-token-here

# Pinecone
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_INDEX_NAME=trading-memory
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trading_sim
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# Guardrail Settings
VIX_DEFENSIVE_THRESHOLD=25
PAPER_TRADING_BUDGET=100
MAX_ASSETS=5
MIN_ALLOCATION=10

# Polygon.io (paid/real-time tier required for news + insights)
# Sign up at https://polygon.io — Starter plan ($29/mo) includes news with sentiment insights
POLYGON_API_KEY=your-polygon-api-key-here
